# Banco PROPRIO da aplicacao.
# Mock (padrao): SQLite. Producao: Postgres.
DATABASE_URL=sqlite:///./otif.db
# DATABASE_URL=postgresql+psycopg://otif:senha@localhost:5432/otif

# Origem dos dados do ERP: "mock" (snapshot fake) ou "sqlserver" (JUND real).
ERP_SOURCE=mock
# Em sqlserver, "direct" consulta o JUND no ciclo da API; "snapshot" e rollback.
ERP_READ_MODE=direct
ERP_LOOKBACK_MONTHS=12
ERP_CACHE_TTL_SECONDS=10
ERP_ERROR_BACKOFF_SECONDS=15

# Faltando este numero de dias (ou menos) para o Contract Date, o pendente
# entra em "atencao". O prazo em si vem do pedido no JUND e nao tem fallback.
DIAS_ALERTA_PRAZO=7

# Meta de OTIF padrao, usada enquanto nao houver configuracao salva no banco.
META_OTIF=95

# --- Conexao READ-ONLY com o Jundsoft (apenas quando ERP_SOURCE=sqlserver) ---
# A instancia MSSQLJUND responde na porta TCP 52702 (descoberta via SQL Browser).
# JUNDSOFT_HOST=10.10.1.5,52702
# JUNDSOFT_DB=jundsoft
# JUNDSOFT_USER=usuario_readonly
# JUNDSOFT_PASSWORD=troque_aqui
# JUNDSOFT_ODBC_DRIVER=SQL Server
# Parametros ODBC extras (opcional). Necessario com "ODBC Driver 18 for SQL Server"
# quando o servidor usa certificado autoassinado:
# JUNDSOFT_ODBC_EXTRA=Encrypt=yes;TrustServerCertificate=yes

# Origens liberadas no CORS (frontend Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
