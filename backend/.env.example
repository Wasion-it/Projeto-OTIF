# Banco PROPRIO da aplicacao.
# Mock (padrao): SQLite. Producao: Postgres.
DATABASE_URL=sqlite:///./otif.db
# DATABASE_URL=postgresql+psycopg://otif:senha@localhost:5432/otif

# Origem dos dados do ERP: "mock" (snapshot fake) ou "sqlserver" (JUND real).
ERP_SOURCE=mock
# Em sqlserver, "direct" consulta o JUND no ciclo da API; "snapshot" e rollback.
ERP_READ_MODE=direct
ERP_LOOKBACK_MONTHS=12
ERP_CACHE_TTL_SECONDS=10
ERP_ERROR_BACKOFF_SECONDS=15

# Faltando este numero de dias (ou menos) para o Contract Date, o pendente
# entra em "atencao". O prazo em si vem do pedido no JUND e nao tem fallback.
DIAS_ALERTA_PRAZO=7

# Meta de OTIF padrao, usada enquanto nao houver configuracao salva no banco.
META_OTIF=95

# --- Conexao READ-ONLY com o Jundsoft (apenas quando ERP_SOURCE=sqlserver) ---
# A aplicacao deve usar um usuario DEDICADO e SOMENTE LEITURA.
# Nao utilize conta administrativa (ex.: sa) em producao.
# Host e porta sao separados; a aplicacao monta SERVER=<host>,<porta>.
JUNDSOFT_HOST=db-jundsoft.exemplo.local
JUNDSOFT_PORT=52702
JUNDSOFT_DATABASE=JUNDSOFT
JUNDSOFT_USERNAME=otif_readonly
JUNDSOFT_PASSWORD=troque_aqui
# Nome exato do driver em pyodbc.drivers(). Container Linux: ODBC Driver 18.
# No Windows sem o Driver 18 instalado, use o driver existente (ex.: SQL Server).
JUNDSOFT_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Viram Encrypt=yes/no e TrustServerCertificate=yes/no na string de conexao.
# Defaults da aplicacao: ENCRYPT=true, TRUST_SERVER_CERTIFICATE=false.
# TRUST_SERVER_CERTIFICATE=true e aceitavel TEMPORARIAMENTE em ambiente
# interno com certificado nao confiavel (autoassinado). Com certificado
# confiavel, use JUNDSOFT_TRUST_SERVER_CERTIFICATE=false.
JUNDSOFT_ENCRYPT=true
JUNDSOFT_TRUST_SERVER_CERTIFICATE=true

# --- Inspecao LEM automatica (jigadb, MySQL) ---
# manual: o time registra a data real no painel (padrao).
# jigadb: inicio/fim da inspecao saem das OS INSP_* do jigadb, ligadas ao pedido
#         por lote -> OP -> JUND. Pedido com varios lotes: inicio do primeiro
#         lote e fim do ultimo. Exige ERP_SOURCE=sqlserver e ERP_READ_MODE=direct.
LEM_SOURCE=manual
# Use um usuario DEDICADO e SOMENTE LEITURA (SELECT) no schema jigadb.
JIGADB_HOST=jigadb.exemplo.local
JIGADB_PORT=3306
JIGADB_DATABASE=jigadb
JIGADB_USERNAME=otif_readonly
JIGADB_PASSWORD=troque_aqui
JIGADB_CONNECT_TIMEOUT=10
# Prefixo das OS de inspecao (INSP -> INSP_%), igual ao relatorio de inspecao.
JIGADB_PREFIXO_OS_INSP=INSP
JIGADB_CACHE_TTL_SECONDS=60

# --- Producao automatica (jigadb) ---
# manual: o time registra o fim real das OPs no painel (padrao).
# jigadb: inicio = primeira lacracao e fim = ultima lacracao dos lotes do
#         pedido (regra do Relatorio de Lotes PCP do wasion-report). O fim so
#         existe quando todos os lotes tem medidores produzidos >= quantidade
#         do lote. Exige LEM_SOURCE=jigadb, ERP_SOURCE=sqlserver e
#         ERP_READ_MODE=direct. Usa a mesma conexao JIGADB_* acima.
PRODUCAO_SOURCE=manual

# Origens liberadas no CORS (frontend Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
