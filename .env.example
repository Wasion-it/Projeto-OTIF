# ---------------------------------------------------------------------------
# Variaveis para docker-compose.yml (DEV / validacao local).
# Copie para .env e ajuste. NUNCA versione o .env real.
# ---------------------------------------------------------------------------

# --- PostgreSQL local (somente DEV; em producao o banco e externo) ---
POSTGRES_USER=otif
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=otif

# O compose monta a URL do backend a partir das variaveis acima:
#   postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@otif-postgres:5432/${POSTGRES_DB}
# ATENCAO: a senha entra na URL sem codificacao. Caracteres reservados
# (@ : / # % ? &) precisam de URL-encoding (ex.: @ -> %40, # -> %23), ou
# defina a URL completa abaixo para sobrescrever a montagem automatica:
# DATABASE_URL=postgresql+psycopg://otif:senha%40codificada@otif-postgres:5432/otif

# Aplica `alembic upgrade head` na subida do backend. No compose de DEV o
# padrao e true porque o Postgres local nasce vazio (sem schema as rotas de
# negocio falham, embora /health responda).
RUN_MIGRATIONS=true

# --- Portas publicadas no host ---
# A API nao tem autenticacao: por padrao o backend so escuta em 127.0.0.1 no
# host; o acesso pela rede passa pelo frontend (Nginx faz proxy da API).
# Use 0.0.0.0 apenas se precisar expor a API diretamente.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- ERP ---
# "mock" (snapshot fake) ou "sqlserver" (Jundsoft real, somente leitura).
ERP_SOURCE=mock
ERP_READ_MODE=direct

# --- Jundsoft (SQL Server, READ-ONLY) - apenas quando ERP_SOURCE=sqlserver ---
# A aplicacao deve usar um usuario DEDICADO e SOMENTE LEITURA.
# Nao utilize conta administrativa (ex.: sa) em producao.
# Host e porta sao separados; a aplicacao monta SERVER=<host>,<porta>.
JUNDSOFT_HOST=db-jundsoft.exemplo.local
JUNDSOFT_PORT=52702
JUNDSOFT_DATABASE=JUNDSOFT
JUNDSOFT_USERNAME=otif_readonly
JUNDSOFT_PASSWORD=troque_aqui
# Driver disponivel na imagem Linux do backend.
JUNDSOFT_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Viram Encrypt=yes/no e TrustServerCertificate=yes/no na string de conexao.
# Defaults da aplicacao: ENCRYPT=true, TRUST_SERVER_CERTIFICATE=false.
# TRUST_SERVER_CERTIFICATE=true e aceitavel TEMPORARIAMENTE em ambiente
# interno com certificado nao confiavel (autoassinado). Com certificado
# confiavel, use JUNDSOFT_TRUST_SERVER_CERTIFICATE=false.
JUNDSOFT_ENCRYPT=true
JUNDSOFT_TRUST_SERVER_CERTIFICATE=true

# --- Inspecao LEM automatica (jigadb, MySQL, READ-ONLY) ---
# manual (padrao) ou jigadb. Com jigadb exige ERP_SOURCE=sqlserver e
# ERP_READ_MODE=direct. Use um usuario DEDICADO com apenas SELECT.
LEM_SOURCE=manual
JIGADB_HOST=jigadb.exemplo.local
JIGADB_PORT=3306
JIGADB_DATABASE=jigadb
JIGADB_USERNAME=otif_readonly
JIGADB_PASSWORD=troque_aqui
JIGADB_CONNECT_TIMEOUT=10
JIGADB_PREFIXO_OS_INSP=INSP
JIGADB_CACHE_TTL_SECONDS=60

# --- Producao automatica (jigadb) ---
# manual (padrao) ou jigadb. Inicio/fim = primeira/ultima lacracao dos lotes do
# pedido; o fim so existe com todos os lotes completos. Com jigadb exige
# LEM_SOURCE=jigadb, ERP_SOURCE=sqlserver e ERP_READ_MODE=direct.
PRODUCAO_SOURCE=manual

# --- Frontend ---
# Vazio = SPA chama a mesma origem e o Nginx faz proxy para o backend.
VITE_API_URL=
